class Solution {
        void pushZerosToEnd(int[] arr) {
        int a=arr.length;
        int j = 0;
        for(int i=0;i<a;i++)
        {
            if(arr[i]!=0)
            {
                int temp=arr[i];
                arr[i]=arr[j];
                arr[j]=temp;
                j++;
            }
        }
    }
}
